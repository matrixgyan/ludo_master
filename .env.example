# ==============================================================================
# LUDO WORLD MASTER — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api
NEXT_PUBLIC_API_URL=http://localhost:3000/api
WS_URL=ws://localhost:3000/ws
NEXT_PUBLIC_WS_URL=ws://localhost:3000/ws

# ------------------------------------------------------------------------------
# 1. NEON POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# Connection string to Neon PostgreSQL (pooled or direct)
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_POOL_MIN=2
DB_POOL_MAX=20

# ------------------------------------------------------------------------------
# 2. REDIS CONFIGURATION (Ephemerality, Matchmaking, Locks, Presence)
# ------------------------------------------------------------------------------
# Supports either REDIS_URL or granular credentials
REDIS_URL=redis://default:samplepassword@redis-12345.c250.us-east-1-1.ec2.cloud.redislabs.com:12345
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_DB=0

# ------------------------------------------------------------------------------
# 3. BULLMQ QUEUE CONFIGURATION
# ------------------------------------------------------------------------------
BULLMQ_PREFIX=ludo_production
BULLMQ_CONCURRENCY=5

# ------------------------------------------------------------------------------
# 4. SERVER IDENTIFIERS & SECURITY SECRETS
# ------------------------------------------------------------------------------
GAME_SERVER_ID=game-server-node-01
GAME_SERVER_SECRET=change-this-to-a-secure-random-secret-in-production
SESSION_SECRET=change-this-session-secret-in-production
INTERNAL_API_SECRET=change-this-internal-api-secret-in-production

# ------------------------------------------------------------------------------
# 5. AI / GEMINI CONFIGURATION
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
