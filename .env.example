# ==============================================================================
# LUDO WORLD MASTER — PRODUCTION & VERCEL ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Runtime
NODE_ENV=
PORT=

# 1. NEON POSTGRESQL (Permanent Database Source of Truth)
DATABASE_URL=

# 2. REDIS / UPSTASH (Realtime State, Matchmaking, Presence, Locks, Queues)
REDIS_URL=

# 3. CLOUDFLARE R2 (Player Avatars, Game Assets, Object Storage)
# (Auto-detected: R2_* or CLOUDFLARE_R2_*)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional Gemini AI Features
GEMINI_API_KEY=

